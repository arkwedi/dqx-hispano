# .env.example
#
# Copia este archivo como ".env" y rellena tus valores reales.
# El ".env" real NUNCA se sube al repo (ver .gitignore) -- este archivo de
# ejemplo si se sube, para que cualquiera que clone el proyecto sepa que
# variables necesita configurar.

# --- Supabase ---
# Project Settings -> Database -> Connection string -> Transaction pooler
# (NO uses la conexion directa "db.xxxx.supabase.co" -- falla por DNS/IPv6
# en la mayoria de conexiones domesticas. Usa la del pooler, puerto 6543.)
DATABASE_URL=postgresql://postgres.tu-project-ref:tu-password@aws-0-region.pooler.supabase.com:6543/postgres

# --- DeepL (solo necesario para bulk_mt_translate.py) ---
# https://www.deepl.com/your-account/keys
DEEPL_API_KEY=tu-api-key-de-deepl

# --- Rutas locales de Clarity (solo si corres los scripts que tocan tu
# instalacion local: glossary_bulk_update_sqlite.py, export_translations.py
# con --clarity-glossary-db/--clarity-dialog-db) ---
CLARITY_GLOSSARY_DB_PATH=C:\ruta\a\glossary.db
CLARITY_DIALOG_DB_PATH=C:\ruta\a\clarity_dialog.db

# --- Frontend (frontend/index.html) ---
# Estas dos NO son secretas -- el "anon key" de Supabase esta disenado para
# vivir en el navegador de cualquiera que abra la pagina. La seguridad real
# la da el RLS (ver supabase/migrations/002_rls_anon_access.sql), no que
# esta clave este oculta. Por eso van hardcodeadas directo en el HTML, no
# leidas desde este .env (una pagina estatica en GitHub Pages no puede leer
# variables de entorno en tiempo de ejecucion). Se documentan aqui solo
# como referencia de donde sacarlas: Project Settings -> API.
SUPABASE_URL=https://tu-project-ref.supabase.co
SUPABASE_ANON_KEY=tu-anon-public-key
